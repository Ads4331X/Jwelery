# Backend API URL.
# Local development defaults directly to localhost:5000.
# Set to http://localhost:5173 to use the Vite development proxy instead.
# For separate Vercel frontend/backend projects, set this to the backend
# deployment origin (for example https://your-api.vercel.app).
VITE_API_URL=http://localhost:5000

# Optional cookie domain for the customer auth cookie.
# Dev: leave unset (defaults to "localhost").
# Prod: leave unset too — it will default to your actual domain automatically.
# Only set this explicitly if you need the cookie shared across subdomains,
# e.g. VITE_COOKIE_DOMAIN=.yourdomain.com
# VITE_COOKIE_DOMAIN=